    "speech_end_seconds": 58.6798125,
    "end_seconds": 70.6798125,
    "text": "这场活动的总预算上限是七百八十元，所有采购加起来不能超过这个数。"
  },
  {
    "sequence_index": 3,
    "phase": "initial",
